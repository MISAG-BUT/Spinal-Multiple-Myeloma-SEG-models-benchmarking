+def filter_objects_by_size(mask: np.ndarray, min_size: int, max_size: int) -> np.ndarray:
+    """
+    Filter connected components in the mask to keep only those with sizes between min_size and max_size (inclusive).
+    """
+    labeled = label(mask)
+    sizes = np.bincount(labeled.ravel())[1:]  # sizes of components (ignore background)
+    keep_labels = np.where((sizes >= min_size) & (sizes <= max_size))[0] + 1
+    filtered_mask = np.isin(labeled, keep_labels)
+    return filtered_mask.astype(mask.dtype)
+
 
